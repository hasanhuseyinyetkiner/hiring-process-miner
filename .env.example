# Copy to .env for local overrides. Do not commit .env.
APP_ENV=demo
DATABASE_URL=sqlite:///./data/hpm.sqlite
HOST=127.0.0.1
PORT=8102
ALLOW_NETWORK_BIND=false
CORS_ORIGINS=http://127.0.0.1:5102,http://localhost:5102
MAX_UPLOAD_BYTES=10485760
MAX_ROWS=50000
STALE_JOB_SECONDS=900
# Settings default is true; set false for empty-DB tests.
SEED_ON_STARTUP=true
HPM_RESET_DB=0
